title: 下个月
set-bg: img/map_2.jpg
is-hand: true
on-arrival: {!
if (Q.advisor_action_timer <= 0) {
    Q.pinnedCardsDescription = '顾问——可执行行动。';
} else if (Q.advisor_action_timer == 1) {
    Q.pinnedCardsDescription = '顾问——1个月后可执行下一次行动。';
} else {
    Q.pinnedCardsDescription = '顾问——' + Q.advisor_action_timer + '个月后可执行下一次行动。';
}
!}
max-cards: 3

#Here, the main deck will be displayed. Clicking on the deck draws a card into your hand. Clicking on a card activates that card.

[? if year = 1928 and month = 2 : 当前资产阶级右翼政府已垮台。下一次选举预计在今年5月举行。 ?]

- @party
- @govt
- @pres
- #advisor
- @shuffle_leadership_pinned
- @megatome

